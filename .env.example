# TerraHub Database Configuration
# Copy this file to .env and fill in your actual values. Never commit .env.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=TerraHub
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432


# Create one at https://console.anthropic.com/settings/keys and paste it here.

ANTHROPIC_API_KEY=sk-ant-...
